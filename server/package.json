{
  "name": "healthcare-portal-server",
  "version": "2.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/db/migrate.js && node src/db/seed.js && node --watch src/server.js",
    "start": "node src/db/migrate.js && node src/db/seed.js && node src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --env-file=.env.test node_modules/.bin/jest --runInBand",
    "test:ci": "jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.1",
    "zod": "3.23.8",
    "drizzle-orm": "0.45.4",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.0.0",
    "drizzle-kit": "0.31.11"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  }
}
