# Copy to server/.env for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Set to true for managed Postgres that requires TLS (Render, Neon)
DB_SSL=false
# Optional TURN relay for strict NATs / mobile networks (comma-separate multiple URLs)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
